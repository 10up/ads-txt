{
  "name": "@10up/ads-txt",
  "version": "1.4.6",
  "description": "Create, manage, and validate your ads.txt and app-ads.txt from within WordPress, just like any other content asset.",
  "homepage": "https://github.com/10up/ads-txt",
  "bugs": {
    "url": "https://github.com/10up/ads-txt/issues"
  },
  "license": "GPL-2.0-or-later",
  "author": {
    "name": "10up",
    "email": "opensource@10up.com",
    "url": "https://10up.com",
    "role": "developer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10up/ads-txt.git"
  },
  "scripts": {
    "wp-env": "wp-env",
    "wp-env:test": "wp-env --config=.wp-env.test.json",
    "test:php": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/ads-txt vendor/bin/phpunit -c phpunit.xml.dist",
    "test:php:multisite": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/ads-txt env WP_MULTISITE=1 vendor/bin/phpunit -c phpunit.xml.dist",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:debug": "playwright test --config tests/e2e/playwright.config.ts --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@wordpress/e2e-test-utils-playwright": "3.3.0",
    "@wordpress/env": "12.2.0"
  }
}
